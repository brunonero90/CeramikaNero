      "sectionType": "gallery-or-grid",
      "heading": "🌞🎨LETNIA AKADEMIA RYSUNKU, MALARSTWA",
      "headings": [
        "🌞🎨LETNIA AKADEMIA RYSUNKU, MALARSTWA",
