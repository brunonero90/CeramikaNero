    "13d21c63-b5ec-5912-8397-c3a5ddb27a97": {
      "TPAMultiSection_lapuvdh0_queryServices-{\"slug\":\"poranki-z-ceramiką-dla-dorosłych\",\"isBookOnlineAllowed\":true,\"types\":[\"CLASS\",\"APPOINTMENT\"],\"withStaffLocations\":true}": {
        "services": [
          {
            "id": "aa57a637-1826-4aca-9710-cbc712592261",
            "appId": "13d21c63-b5ec-5912-8397-c3a5ddb27a97",
            "createdByAppId": "13d21c63-b5ec-5912-8397-c3a5ddb27a97",
            "type": "CLASS",
            "sortOrder": 11,
            "name": "PORANKI Z CERAMIKĄ DLA     DOROSŁYCH",
            "description": "📢 Poranki z Ceramiką – twórczy relaks na dobry początek dnia!\n\nSzukasz sposobu na spokojne i kreatywne poranki? Warsztaty ceramiczne to idealna okazja, aby oderwać się od codziennych obowiązków i stworzyć coś wyjątkowego w inspirującej atmosferze.\n\n🌞 Dla kogo?\n👩‍🎨 Freelancerzy i wolne zawody, osoby nie pracujące  – zacznij dzień od kreatywnego resetu\n👨‍🎓 Studenci – chwila twórczego oddechu przed zajęciami\n🧓 Emeryci – relaksujące hobby w kameralnym gronie\n\n🎨 Co czeka na Ciebie?\n☕ Poranna herbata w klimatycznej pracowni\n👐 Praca z gliną – nauka i rozwój pod okiem doświadczonych ceramików\n🧘 Kameralna, spokojna atmosfera sprzyjająca pełnemu skupieniu\n\nNie czekaj, zarezerwuj swoje miejsce i zacznij dzień twórczo! ✨\n\n📍 Rezerwacja: www.ceramikanero.com\n4 zajęcia do wykorzystania w ciągu 2 miesięcy \n10 zajęć do wykorzystania w ciągu 4 miesięcy \n\nDołącz do nas i zacznij dzień twórczo z ceramiką!\n\nZ twórczym pozdrowieniem,\n\nMałgosia Nero \nPracownia ceramiki Nero \nTel. 600 158 318 \nmail: nerogosia@gmail.com ",
            "tagLine": "WTORKI 10.00",
            "defaultCapacity": 12,
