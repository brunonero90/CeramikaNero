# Public site URL used for Open Graph, sitemap and absolute links.
NEXT_PUBLIC_SITE_URL=

# Supabase (PostgreSQL, auth, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe (payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to protect the expiry cron endpoint
BOOKING_CRON_SECRET=

# ---------------------------------------------------------------------------
# Local booking isolation (development only — never enable in production)
# ---------------------------------------------------------------------------
# When BOOKING_LOCAL_MODE=1 the public calendar and booking flow use a
# file-backed store under tmp/local-booking/ and NEVER mutate Supabase.
# Confirmation emails are written to the local outbox instead of Resend.
BOOKING_LOCAL_MODE=
# Password for /admin/local (minimum 8 characters). Required for local admin.
LOCAL_ADMIN_SECRET=
# Optional: force homepage calendar [TEST] fixtures for visual fidelity capture.
FIDELITY_FIXTURES=
