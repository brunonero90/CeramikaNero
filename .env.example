# Public site URL used for Open Graph, sitemap and absolute links.
# Production test host: https://ceramikanero.pl (noindex until SITE_ALLOW_INDEXING=1)
NEXT_PUBLIC_SITE_URL=

# Supabase (PostgreSQL, auth, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe (payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cart/order checkout provider: manual | stripe | both
# manual = bank transfer only (default)
# stripe = Stripe Checkout when configured (fails closed if misconfigured)
# both = customer chooses explicitly at checkout
PAYMENTS_PROVIDER=manual

# Resend (transactional emails) — server-only; see docs/EMAIL-ACTIVATION.md
RESEND_API_KEY=
# Example: Ceramika Nero <rezerwacje@ceramikanero.pl>
RESEND_FROM_EMAIL=
# Example: kontakt@ceramikanero.pl
RESEND_REPLY_TO_EMAIL=
# Administrator recipient for new-booking notifications (server-only)
# Example: kontakt@ceramikanero.pl
BOOKING_ADMIN_EMAIL=

# Indexing while testing ceramikanero.pl against ceramikanero.com SEO
# SITE_NOINDEX=1
# SITE_ALLOW_INDEXING=1

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to protect the expiry / email-dispatch cron endpoints
BOOKING_CRON_SECRET=

# ---------------------------------------------------------------------------
# Local booking isolation (development only — never enable in production)
# ---------------------------------------------------------------------------
# When BOOKING_LOCAL_MODE=1 the public calendar and booking flow use a
# file-backed store under tmp/local-booking/ and NEVER mutate Supabase.
# Confirmation emails are written to the local outbox instead of Resend.
BOOKING_LOCAL_MODE=
# Password for /admin/local (minimum 8 characters). Required for local admin.
LOCAL_ADMIN_SECRET=
# Optional: force homepage calendar [TEST] fixtures for visual fidelity capture.
FIDELITY_FIXTURES=
